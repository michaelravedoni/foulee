{
  "name": "foulee",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @foulee/app dev",
    "build": "pnpm --filter @foulee/app build",
    "preview": "pnpm --filter @foulee/app preview",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
